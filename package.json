{
  "name": "@aadiaiagent/agent-runtime",
  "version": "0.1.0",
  "description": "Tool-calling LLM agent runtime with streaming, memory, and structured tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/basic.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["agent", "llm", "tools", "runtime", "ai"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
